# Public Supabase project settings. Safe to expose to the browser -- these
# are matched with Row Level Security policies in supabase/migrations, which
# are what actually enforce tenant isolation and permissions.
VITE_SUPABASE_URL=https://ddtwiujzbwwgvjcdkexv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-side only. NEVER prefix this with VITE_, never reference it from
# src/, and never commit a real value. Used only by supabase/functions/*
# (Edge Functions), where it is read from the function runtime's own
# environment -- it must be set via `supabase secrets set`, not this file.
SUPABASE_SECRET_KEY=your_secret_key_here
